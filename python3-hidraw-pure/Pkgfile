# Description: Pure-python linux hidraw bindings
# URL: https://pypi.org/project/hidraw-pure/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-ioctl-opt

name=python3-hidraw-pure
version=1.2
release=1
source=(https://github.com/vpelletier/python-hidraw/archive/v$version/$name-$version.tar.gz)

build() {
  cd python-hidraw-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
