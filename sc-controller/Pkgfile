# Description: User-mode driver and GTK3 based GUI for Steam Controller
# URL: https://github.com/kozec/sc-controller
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: gtk-layer-shell python3-evdev python3-gobject python3-hidraw-pure python3-libusb1 python3-pylibacl python3-setuptools-scm

name=sc-controller
version=0.6.3
release=2
source=(https://github.com/C0rn3j/sc-controller/archive/refs/tags/v$version.tar.gz
  627a5bfee12266c6f2a1338f197d946a9a1886a1.patch)
renames=($name-$version.tar.gz SKIP)

build() {
  cd $name-$version

  patch -Np1 -i $SRC/627a5bfee12266c6f2a1338f197d946a9a1886a1.patch
  SETUPTOOLS_SCM_PRETEND_VERSION=$version \
  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
